{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m ruff *)",
      "Bash(python -m pip install *)",
      "Bash(pip install *)",
      "Bash(python herramientas/*)",
      "Bash(python run.py*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(python -m ruff *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(pip install *)",
      "PowerShell(python herramientas/*)",
      "PowerShell(python run.py*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push* --force*)",
      "Bash(git push* -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(git push* --force*)",
      "PowerShell(git push* -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)"
    ]
  }
}
